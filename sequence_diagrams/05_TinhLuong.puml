@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #FF6F00
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Kế toán" as Accountant
boundary "UI_TinhLuong" as Frontend
control "TinhLuong_Controller" as Controller
control "Salary_Calculator" as Calculator
entity "Database" as DB

Accountant -> Frontend: Chọn tháng/năm và click "Tính lương"
Frontend -> Controller: POST /api/payroll/calculate

Controller -> DB: Employee.find({ status: 'active' })
DB --> Controller: Danh sách employees

loop Cho mỗi nhân viên
    Controller -> Calculator: calculateMonthlySalary(employeeId, year, month)
    Calculator -> DB: Lấy Attendance, Leave, Settings
    DB --> Calculator: Data
    Calculator -> Calculator: Tính lương (workingDays, OT, penalties)
    Calculator --> Controller: Payroll data
    Controller -> DB: Payroll.findOneAndUpdate (upsert)
    DB --> Controller: Payroll saved
end

Controller -> Frontend: Response 200 { results, errors }
Frontend --> Accountant: Hiển thị kết quả

@enduml

