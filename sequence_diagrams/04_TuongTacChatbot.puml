@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #1976D2
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Nhân viên" as Employee
boundary "UI_Chatbot" as Frontend
control "Chatbot_Controller" as Controller
control "LLM_Service" as LLM
entity "Database" as DB

Employee -> Frontend: Nhập câu hỏi và gửi
Frontend -> Controller: POST /api/chat/message
Controller -> LLM: classifyIntent(text)

alt [Phân tích được]
    LLM --> Controller: Intent và entities
    Controller -> DB: Lấy dữ liệu theo intent
    DB --> Controller: Data
    Controller -> Frontend: Response 200 { message }
    Frontend --> Employee: Hiển thị reply
else [Không phân tích được]
    LLM --> Controller: null/error
    Controller -> Frontend: Response 200\n{ message: "Tôi không hiểu..." }
    Frontend --> Employee: Hiển thị thông báo lỗi
end

@enduml

