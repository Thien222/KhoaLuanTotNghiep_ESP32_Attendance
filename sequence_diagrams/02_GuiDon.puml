@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #1976D2
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Nhân viên" as Employee
boundary "UI_GuiDon" as Frontend
control "GuiDon_Controller" as Controller
entity "Database" as DB

alt Đơn nghỉ phép
    Employee -> Frontend: Điền form và gửi đơn nghỉ phép
    Frontend -> Controller: POST /api/leave
    Controller -> DB: Tạo Leave (status: 'pending')
    DB --> Controller: Leave created
    Controller -> Frontend: Response 201
    Frontend --> Employee: Thông báo thành công

else Đơn đăng ký OT
    Employee -> Frontend: Điền form và gửi đơn OT
    Frontend -> Controller: POST /api/overtime/request
    Controller -> DB: Kiểm tra trùng lặp
    
    alt [Đã có đơn]
        DB --> Controller: existingRequest found
        Controller -> Frontend: Response 400
        Frontend --> Employee: Hiển thị lỗi
    else [Chưa có đơn]
        Controller -> DB: Tạo OvertimeRequest (status: 'pending')
        DB --> Controller: OvertimeRequest created
        Controller -> Frontend: Response 201
        Frontend --> Employee: Thông báo thành công
    end
end

@enduml

