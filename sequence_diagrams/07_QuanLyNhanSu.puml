@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #FF6F00
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Quản lý" as Manager
boundary "UI_QuanLyNhanSu" as Frontend
control "QuanLyNhanSu_Controller" as Controller
entity "Database" as DB

alt Thêm nhân viên
    Manager -> Frontend: Điền form và lưu
    Frontend -> Controller: POST /api/employees
    Controller -> DB: new Employee().save()
    DB --> Controller: Employee created
    Controller -> Frontend: Response 201
    Frontend --> Manager: Thông báo thành công

else Cập nhật nhân viên
    Manager -> Frontend: Chỉnh sửa thông tin và lưu
    Frontend -> Controller: PUT /api/employees/:id
    Controller -> DB: Employee.findByIdAndUpdate
    DB --> Controller: Employee updated
    Controller -> Frontend: Response 200
    Frontend --> Manager: Thông báo thành công

else Xóa nhân viên
    Manager -> Frontend: Chọn nhân viên và xác nhận xóa
    Frontend -> Controller: DELETE /api/employees/:id
    Controller -> DB: Employee.findByIdAndDelete
    DB --> Controller: Employee deleted
    Controller -> Frontend: Response 200
    Frontend --> Manager: Thông báo thành công

else Đăng ký vân tay
    Manager -> Frontend: Chọn nhân viên và đăng ký vân tay
    Frontend -> Controller: POST /api/employees/enroll-fingerprint
    Controller -> DB: Employee.findByIdAndUpdate\n(fingerprintEnrolled: true)
    DB --> Controller: Employee updated
    Controller -> Frontend: Response 200
    Frontend --> Manager: Thông báo thành công
end

@enduml

