@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #1976D2
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Nhân viên" as Employee
boundary "UI_LichSuChamCong" as Frontend
control "ChamCong_Controller" as Controller
control "ChamCong_Service" as Service
entity "Database" as DB

Employee -> Frontend: 1. Vào trang "Lịch sử chấm công"
Frontend --> Employee: 1.1: Hiển thị form chọn khoảng thời gian

Employee -> Frontend: 2. Chọn khoảng thời gian\n(startDate, endDate)
Employee -> Frontend: 2.1: Click "Xem" hoặc tự động load

Frontend -> Controller: 2.1.1: GET /api/attendance\n?startDate=...&endDate=...
Controller -> Controller: 2.1.1.1: getAllAttendance(req, res)\nTừ attendanceController.js
Controller -> Controller: 2.1.1.2: Kiểm tra role\nif (user.role === 'employee')
Controller -> Controller: 2.1.1.3: Lấy employeeId từ req.user.employee
Controller -> Service: 2.1.1.4: xuLyLayLichSuChamCong\n(employeeId, startDate, endDate)
Service -> Service: 2.1.1.5: Chuyển đổi dates với moment.tz\nstart = moment.tz(startDate).startOf('day')\nend = moment.tz(endDate).endOf('day')
Service -> DB: 2.1.1.6: Attendance.find({\n  employee: employeeId,\n  date: { $gte: start, $lte: end }\n}).populate('employee')\n.sort({ date: -1 })

alt [Không có dữ liệu]
    DB --> Service: [] (mảng rỗng)
    Service --> Controller: 2.1.2: Trả về danh sách rỗng
    Controller -> Frontend: 2.1.2.1: Response 200\n{ success: true, data: [] }
    Frontend --> Employee: 2.1.2.1.1: Hiển thị: "Không có dữ liệu chấm công\n trong khoảng thời gian này"
else [Có dữ liệu]
    DB --> Service: Attendance records với employee data
    Service -> Service: 2.1.1.7: Sắp xếp theo ngày\n.sort({ date: -1, createdAt: -1 })
    Service --> Controller: 2.1.3: Trả về danh sách Attendance records
    Controller -> Frontend: 2.1.3.1: Response 200\n{ success: true, data: attendance }
    Frontend --> Employee: 2.1.3.1.1: Hiển thị bảng lịch sử chấm công\nvới các thông tin:\nngày, giờ vào/ra, trạng thái,\ngiờ làm, OT, phạt
end

@enduml

