@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #FF6F00
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Quản lý" as Manager
boundary "UI_QuanLyChamCong" as Frontend
control "QuanLyChamCong_Controller" as Controller
entity "Database" as DB

== Xem danh sách ==

Manager -> Frontend: Chọn khoảng thời gian và tìm kiếm
Frontend -> Controller: GET /api/attendance
Controller -> DB: Attendance.find().populate('employee')
DB --> Controller: Attendance records
Controller -> Frontend: Response 200
Frontend --> Manager: Hiển thị bảng chấm công

== Thao tác ==

alt Chỉnh sửa
    Manager -> Frontend: Chọn bản ghi và cập nhật giờ vào/ra
    Frontend -> Controller: PUT /api/attendance/:id
    Controller -> DB: Attendance.findByIdAndUpdate
    DB --> Controller: Attendance updated
    Controller -> Frontend: Response 200
    Frontend --> Manager: Thông báo thành công

else Xóa
    Manager -> Frontend: Chọn bản ghi và xác nhận xóa
    Frontend -> Controller: DELETE /api/attendance/:id
    Controller -> DB: Attendance.findByIdAndDelete
    DB --> Controller: Attendance deleted
    Controller -> Frontend: Response 200
    Frontend --> Manager: Thông báo thành công
end

@enduml

