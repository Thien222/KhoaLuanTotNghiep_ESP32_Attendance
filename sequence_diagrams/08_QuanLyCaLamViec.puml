@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #FF6F00
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Quản lý" as Manager
boundary "UI_QuanLyCaLamViec" as Frontend
control "QuanLyCaLamViec_Controller" as Controller
entity "Database" as DB

Manager -> Frontend: Thao tác với ca làm việc
Frontend -> Controller: POST/PUT /api/shifts

alt Tạo/Cập nhật ca
    Controller -> DB: Save/Update Shift
    DB --> Controller: Success
    Controller --> Manager: Thành công
else Xóa ca
    Controller -> DB: Check EmployeeShift
    DB --> Controller: Có/Không có nhân viên
    Controller -> DB: Delete Shift (nếu hợp lệ)
    Controller --> Manager: Kết quả
else Gán ca cho nhân viên
    Frontend -> Controller: POST /api/shifts/assign
    loop Mỗi nhân viên
        Controller -> DB: Update/Create EmployeeShift
    end
    Controller --> Manager: Thành công
end

@enduml

