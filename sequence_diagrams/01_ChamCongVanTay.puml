@startuml
!theme plain
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #1976D2
  LifeLineBorderColor #333333
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontSize 12
  ActorFontSize 14
  ActorFontStyle bold
}

actor "Nhân viên" as Employee
boundary "ESP32" as ESP32
control "ChamCong_Controller" as Controller
control "ChamCong_Service" as Service
entity "Database" as DB

== Check-in Flow ==

Employee -> ESP32: 1. Quét vân tay
ESP32 -> Controller: 1.1: POST /api/attendance/fingerprint\n{ fingerId, action: 'auto' }

Controller -> Controller: 1.1.1: addAttendance(req, res)\nTừ attendanceController.js
Controller -> DB: 1.1.1.1: Employee.findOne({ fingerprintId: fingerId })
DB --> Controller: Employee data hoặc null

alt [Không tìm thấy employee / Chưa enroll / Đã chấm công trong 3 phút / Đã xong]
    Controller -> Controller: 1.1.2: Kiểm tra employee\nif (!employee || !employee.fingerprintEnrolled)\nKiểm tra spam (3 phút)\nKiểm tra đã xong
    Controller -> ESP32: 1.1.2.1: Response 200\n{ success: false, message, sub_message, what }
    ESP32 --> Employee: 1.1.2.1.1: Hiển thị lỗi/thông báo
else [Check-in hợp lệ]
    Controller -> Controller: 1.1.1.2: attendanceHelper.getAllSettings()
    Controller -> Controller: 1.1.1.3: attendanceHelper.validateCheckinTime(now, allSettings)
    Controller -> Controller: 1.1.1.4: attendanceHelper.calculateLatePenalty\n(lateMinutes, latePolicy, dailyRate)
    Controller -> DB: 1.1.1.5: new Attendance({\n  employee, fingerprintId, date,\n  checkIn: { time, status },\n  status, lateMinutes, actualPenalty\n})
    DB --> Controller: await attendance.save()
    Controller -> ESP32: 1.1.3: Response 200\n{ success: true,\n  message: "Xin chao [Ten]",\n  sub_message, what: 'in' }
    ESP32 --> Employee: 1.1.3.1: Hiển thị thông báo
else [Check-out hợp lệ]
    Controller -> Controller: 1.1.1.6: attendanceHelper.hasOvertimeShiftForDate\n(employee._id, today)
    Controller -> Controller: 1.1.1.7: attendanceHelper.validateCheckoutTime\n(now, hasOTApproved, allSettings)
    Controller -> Controller: 1.1.1.8: attendanceHelper.calculateEarlyPenalty\n(actualCheckOutTime, dailyRate, allSettings)
    Controller -> Controller: 1.1.1.9: attendanceHelper.calculateWorkingHours\n(checkIn.time, checkOut.time)
    Controller -> Controller: 1.1.1.10: attendanceHelper.calculateOTSalary\n(overtimeHours, mergedOTSettings, today, isHoliday)
    Controller -> DB: 1.1.1.11: attendance.checkOut = { time, status }\nattendance.workingHours = ...\nattendance.overtimeHours = ...\nawait attendance.save()
    DB --> Controller: Attendance updated
    Controller -> ESP32: 1.1.4: Response 200\n{ success: true,\n  message: "Tam biet [Ten]",\n  sub_message, what: 'out' }
    ESP32 --> Employee: 1.1.4.1: Hiển thị thông báo
end

@enduml

