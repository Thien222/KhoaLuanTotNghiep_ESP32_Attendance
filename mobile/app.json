{
  "expo": {
    "name": "HR Management",
    "slug": "hrm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hrm.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.hrm.mobile"
    },
    "sdkVersion": "54.0.0",
    "extra": {
      "eas": {
        "projectId": "e76724e0-41b7-4ece-b86e-26b56a0b393c"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
