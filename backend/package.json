{
  "name": "employee-management-backend",
  "version": "1.0.0",
  "description": "Backend for Employee Management System with Fingerprint",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed:holidays": "node scripts/seedHolidays.js",
    "seed:settings": "node scripts/seedSettings.js",
    "seed:all": "npm run seed:settings && npm run seed:holidays",
    "migrate": "node scripts/migrateEmployeeData.js",
    "test": "node scripts/testAPI.js",
    "setup": "npm install && npm run seed:all",
    "cleanup:unenrolled": "node scripts/cleanupUnenrolledEmployees.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.0",
    "moment-timezone": "^0.5.43",
    "mongoose": "^7.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.10",
    "openai": "^4.0.0",
    "resend": "^6.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
