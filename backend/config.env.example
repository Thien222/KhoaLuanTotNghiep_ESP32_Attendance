# Backend Configuration
# Copy this file to config.env and fill in your actual values

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret Key (use a strong random string)
JWT_SECRET=your_strong_jwt_secret_key_here_change_this_in_production

# Server Configuration
IP_MACHINE=192.168.1.100
IP_ESP32=192.168.1.101
ESP32_URL=http://192.168.1.101
ESP32_CONFIG_PATH=/config
ESP32_FALLBACK_URL=http://192.168.1.101
ESP32_FALLBACK_CONFIG_PATH=/config

# Environment
NODE_ENV=development

# Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Server Port
PORT=3000

