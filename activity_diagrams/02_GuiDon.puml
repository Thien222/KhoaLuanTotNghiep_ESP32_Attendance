@startuml
!theme plain
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 12
}
skinparam swimlane {
  BackgroundColor<<Actor>> #E3F2FD
  BackgroundColor<<System>> #FFF3E0
  BorderColor #333333
  FontSize 14
  FontStyle bold
}

|#E3F2FD|Actor (Nhân viên)|
start
:1. Vào trang "Xin nghỉ phép"\nhoặc "Đăng ký OT",\nđiền form và click "Gửi đơn";
|#FFF3E0|System|
if (Loại đơn?) then (Nghỉ phép)
  :2. Validate ngày,\ntính tổng số ngày nghỉ,\ntạo Leave request\n(status = 'pending');
else (OT)
  :3. Xác định khung giờ OT,\nkiểm tra trùng lặp,\ntạo OvertimeRequest\n(status = 'pending');
endif
:4. Lưu vào database\nvà thông báo thành công;
stop
@enduml

