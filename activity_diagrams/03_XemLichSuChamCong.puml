@startuml
!theme plain
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 12
}
skinparam swimlane {
  BackgroundColor<<Actor>> #E3F2FD
  BackgroundColor<<System>> #FFF3E0
  BorderColor #333333
  FontSize 14
  FontStyle bold
}

|#E3F2FD|Actor (Nhân viên)|
start
:1. Vào trang "Lịch sử chấm công"\nvà chọn khoảng thời gian;
|#FFF3E0|System|
:2. Lấy Attendance records\ncủa nhân viên trong khoảng thời gian,\nsắp xếp và hiển thị danh sách;
if (Có dữ liệu?) then (Không)
  :Hiển thị: "Không có dữ liệu\nchấm công trong khoảng thời gian này";
  stop
else (Có)
  :Hiển thị danh sách;
  stop
endif
@enduml

