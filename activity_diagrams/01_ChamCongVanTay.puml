@startuml
!theme plain
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 12
}
skinparam swimlane {
  BackgroundColor<<Actor>> #E3F2FD
  BackgroundColor<<System>> #FFF3E0
  BorderColor #333333
  FontSize 14
  FontStyle bold
}

|#E3F2FD|Actor (Nhân viên)|
start
:1. Quét vân tay trên ESP32;
|#FFF3E0|System|
:2. Tìm Employee, kiểm tra\nfingerprintEnrolled, chống spam (3 phút);
if (Tìm thấy Employee?) then (Không)
  :Trả về lỗi;
  stop
else (Có)
  :3. Xác định action:\nchưa có record → check-in\nđã check-in → check-out;
  if (Action là gì?) then (Check-in)
    :4. Check-in:\nvalidate giờ mở cổng,\ntính late minutes,\ntạo Attendance record;
  else (Check-out)
    :5. Check-out:\nvalidate thời gian,\ntính early minutes,\nworking hours, OT,\ncập nhật Attendance record;
  endif
  :6. Trả về response cho ESP32;
  stop
endif
@enduml

